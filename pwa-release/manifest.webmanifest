{
  "id": "./",
  "name": "Shopee Vídeo Studio",
  "short_name": "Shopee Studio",
  "description": "Crie prompts, narrações, legendas e edições de vídeo para produtos da Shopee.",
  "lang": "pt-BR",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f5f7fb",
