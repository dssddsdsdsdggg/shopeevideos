  "categories": ["photo", "video", "productivity"],
  "icons": [
    {"src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Criar prompt", "short_name": "Criar", "url": "./?view=creator", "icons": [{"src": "./icons/icon-192.png", "sizes": "192x192"}]},
    {"name": "Áudio no vídeo", "short_name": "Áudio", "url": "./?view=audio", "icons": [{"src": "./icons/icon-192.png", "sizes": "192x192"}]}
  ]
